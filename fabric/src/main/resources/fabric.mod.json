{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contributors": [
    "Cf28",
    "evanbones",
    "BlackGear",
    "Auxiliary",
    "EB Mario",
    "Pee Dog",
    "Daveyx0"
  ],
  "contact": {
    "homepage": "https://discord.gg/Mctsf64CXP"
  },
  "license": "${license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.cf28.adaptedmobs.fabric.AdaptedMobsFabric"
    ],
    "client": [
      "com.cf28.adaptedmobs.fabric.client.AdaptedMobsFabricClient"
    ],
    "fabric-datagen": [
      "com.cf28.adaptedmobs.fabric.data.AMDataGenerator"
    ],
    "modmenu": [
      "com.cf28.adaptedmobs.fabric.client.ModMenuIntegration"
    ],
    "lambdynlights:initializer": [
      "com.cf28.adaptedmobs.common.integrations.LambDynamicLightsIntegration"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "accessWidener": "${mod_id}.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.3",
    "platform": ">=1.3.3",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*",
    "yet_another_config_lib_v3": ">=${yacl_version}"
  },
  "optional": {
    "tolerable-creepers": ">=2.2.4"
  }
}
